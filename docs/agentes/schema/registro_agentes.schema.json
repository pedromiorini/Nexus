{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedromiorini/Nexus/docs/agentes/schema/registro_agentes.schema.json",
  "title": "Registro e claims de agentes do Nexus",
  "$defs": {
    "agente": {
      "type": "object",
      "required": ["id", "operador", "ferramenta", "modelo", "instrucoes", "skills", "escopo_arquivos", "limites", "contato", "last_seen"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "instrucoes": {"type": "object", "required": ["arquivo", "sha256", "versao_aceita"],
          "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        "skills": {"type": "array", "items": {"type": "string"}},
        "escopo_arquivos": {"type": "array", "items": {"type": "string"}},
        "assinaturas_commit": {"type": "array", "items": {"type": "string"}},
        "last_seen": {"type": "string", "format": "date"}
      }
    },
    "claim": {
      "type": "object",
      "required": ["agente", "tarefa", "arquivos", "expira_em"],
      "properties": {"arquivos": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expira_em": {"type": "string", "format": "date-time"}}
    }
  },
  "type": "object",
  "required": ["schema_version", "instrucoes_atuais", "agentes"],
  "properties": {
    "instrucoes_atuais": {"type": "object", "required": ["arquivo", "versao"]},
    "agentes": {"type": "array", "items": {"$ref": "#/$defs/agente"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
  }
}
